# Google Gemini API key — enables AI schema detection, the Business Copilot,
# document chat, and the written report narrative. Without it the app runs on
# offline heuristics and template narratives.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (sensible defaults are built in)
# GEMINI_MODEL=gemini-2.0-flash
# DETECTION_STRATEGY=gemini_first      # gemini_first | heuristic_only | gemini_only
# DETECTION_CONFIRM_THRESHOLD=0.75
# FORECAST_HORIZON=6
# MIN_ROWS_FOR_ML=50
# LOG_LEVEL=INFO
